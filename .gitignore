.DS_Store
Thumbs.db
.vscode/
.idea/
# (.claude/: a session's own files stay out; the project's hooks and path rules are the repository's: RULES.json, CLAUDE.md)
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/rules/
.claude/hooks/__pycache__/
# (the build) build/src/: src/ assembled (tools/parts.mjs assemble src build/src), never committed
build/

# (the openings' stills: tools/gpu/bake-stills.js's output, the build's input folder) never committed
stills/

# (the deploy build) node tools/build.mjs dist; and npm ci's node_modules/: never committed
dist/
node_modules/

# (the wing model's generators: python writes these beside linkage.py) never committed
__pycache__/
