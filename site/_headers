# CSP note: Cloudflare Pages COMBINES headers from every matching rule —
# it does not override. Two rules both setting Content-Security-Policy
# means the browser receives both and enforces the intersection (this
# once silently broke a page's own fetches when /* carried connect-src 'none').
# So CSP lives only on the HTML document paths, scoped with no overlap.
# CSP on non-HTML responses is inert anyway.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# Early Hints: Link headers on the root document let Cloudflare send 103s
# for the render-critical assets. crossorigin on the font links is mandatory
# or the browser double-fetches them.
/
  Cache-Control: max-age=0, must-revalidate
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src https://cloudflareinsights.com https://derekzhou.com/cdn-cgi/rum; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests
  Link: </style.v15.css>; rel=preload; as=style
  Link: </hour.v3.js>; rel=preload; as=script
  Link: </assets/fonts/Geist-400-500.sub2.woff2>; rel=preload; as=font; crossorigin
  Link: </assets/fonts/GeistMono-Regular.sub2.woff2>; rel=preload; as=font; crossorigin

/index.html
  Cache-Control: max-age=0, must-revalidate
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src https://cloudflareinsights.com https://derekzhou.com/cdn-cgi/rum; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests

/404.html
  Cache-Control: max-age=0, must-revalidate
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src https://cloudflareinsights.com https://derekzhou.com/cdn-cgi/rum; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests

# Immutable assets: changed bytes require a renamed file (style.v16.css,
# birds.v13.js, world.v7.js, realm-kit.v2.js, realm-dunes.v4.js,
# realm-above.v3.js, facetform.v2.js, facetpose.v2.js, wingmodel.v2.js,
# model.v2.js, labbird.v2.js, birdwing.v2.js, inkbirds.v3.js, hour.v4.js,
# .sub3 fonts) or returning
# visitors keep stale copies.
/style.v15.css
  Cache-Control: public, max-age=31536000, immutable

